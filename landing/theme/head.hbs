<!-- Route migration redirect script -->
<script>
(function() {
    var path = window.location.pathname;
    if (path.includes('eocv-sim') || path.includes('eocvsim') || path.includes('papervision')) {
        var search = window.location.search || '';
        var hash = window.location.hash || '';
        var newPath = path
            .replaceAll('eocv-sim', 'visionbench')
            .replaceAll('eocvsim', 'visionbench')
            .replaceAll('papervision', 'visiongraph');
        window.location.replace(newPath + search + hash);
    }
})();
</script>

